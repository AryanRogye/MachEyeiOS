<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>get-task-allow</key>
    <true/>
    <!-- Core Access -->
    <key>get-task-allow</key>
    <true/>
    <key>platform-application</key>
    <true/>

    <!-- Sandbox & Container Bypass -->
    <key>com.apple.private.security.app-sandbox</key>
    <false/>
    <key>com.apple.private.security.no-container</key>
    <true/>
    <key>com.apple.private.security.container-required</key>
    <false/>
    <key>com.apple.private.security.no-sandbox</key>
    <true/>

    <!-- Library Validation -->
    <key>com.apple.private.skip-library-validation</key>
    <true/>
    <key>com.apple.private.security.clear-library-validation</key>
    <true/>

    <!-- TCC & Permissions -->
    <key>com.apple.private.tcc.allow</key>
    <true/>
    <key>com.apple.private.system-keychain</key>
    <true/>

    <!-- Advanced Permissions -->
    <key>com.apple.private.kernel.debugger-access</key>
    <true/>
    <key>com.apple.private.security.task_for_pid</key>
    <true/>
    
    <!-- Networking / Hardware -->
    <key>com.apple.private.bluetooth</key>
    <true/>
    <key>com.apple.private.wifi.manager-access</key>
    <true/>
    <key>com.apple.private.network.socket-delegate</key>
    <true/>
    <key>com.apple.private.allow-explicit-graphics-priority</key>
    <true/>

    <!-- App Groups (if needed) -->
    <key>com.apple.private.security.application-groups</key>
    <array>
        <string>group.com.yourcompany.yourapp</string>
    </array>
</dict>
</plist>
